  stories:
  - potion: {fileID: 11400000, guid: 387b60560a6875448b61d4d63aba9d69, type: 2}
    lines:
    - '*rustle* ...the old oak is restless... loud woodcutters came by... a calming drop at its roots will help it sleep...'
  - potion: {fileID: 11400000, guid: 32930a2f26bc159479195a92f90f6ac0, type: 2}
    lines:
    - '*soft chime* ...the fireflies flew south early... the little mushrooms are lost in the dark without their light...'
  - potion: {fileID: 11400000, guid: 70b391c0507088648b7784764b44dc43, type: 2}
    lines:
    - '*rustle* ...a hungry deer keeps nibbling my moss... I wish to hide in the shade until it wanders away...'
  - potion: {fileID: 11400000, guid: f56d0e854410b4143b7def29147754b8, type: 2}
    lines:
    - '*shiver* ...the first frost bit my leaves... a little warmth, please... before the snow comes...'
  - potion: {fileID: 11400000, guid: d6bd3f10682f8124eb003c8440e95252, type: 2}
    lines:
    - '*creak* ...a storm broke a branch of the old birch... mandrake heals bark as well as skin...'
  requestLines:
  - '*rustle* ...could you spare...'
  - '*hopeful chime* ...please...'
  thanksLines:
  - '*happy rustling*'
  disappointedLines:
  - '*sad, quiet rustling*'
