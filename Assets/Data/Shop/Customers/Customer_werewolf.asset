  m_Name: Customer_werewolf
  m_EditorClassIdentifier: Assembly-CSharp::SproutOfDebt.Shop.CustomerData
  displayName: Werewolf
  neutral: {fileID: 21300000, guid: e40191ff8b6b4921aa7535476269b76e, type: 3}
  happy: {fileID: 21300000, guid: 9626f934b463447faf25cf53923412a5, type: 3}
  disappointed: {fileID: 21300000, guid: b5d8c09b94a84847b5845d3fd84d8458, type: 3}
  stories:
  - potion: {fileID: 11400000, guid: 387b60560a6875448b61d4d63aba9d69, type: 2}
    lines:
    - The full moon is in three days and I get so nervous... Last time I howled all night and woke the whole village.
  - potion: {fileID: 11400000, guid: 32930a2f26bc159479195a92f90f6ac0, type: 2}
    lines:
    - When I change, everything goes blurry and I bump into trees. The neighbours think it's funny, but it really hurts.
  - potion: {fileID: 11400000, guid: 70b391c0507088648b7784764b44dc43, type: 2}
    lines:
    - I'm too big and fluffy, everyone stares at me at the market. I just want to buy turnips in peace...
  - potion: {fileID: 11400000, guid: f56d0e854410b4143b7def29147754b8, type: 2}
    lines:
    - My flannel shirts tear every time I change, and the cold gets in. A warm brew helps me sleep through the winter.
  - potion: {fileID: 11400000, guid: d6bd3f10682f8124eb003c8440e95252, type: 2}
    lines:
    - I chased my own tail again and sprained my paw. Please don't tell anyone. It's... a little embarrassing.
  requestLines:
  - S-so... could I please have...
  - Would you... um... have...
  thanksLines:
  - Thanks... really. You're very kind.
  disappointedLines:
  - Oh... that's okay. Don't worry.
