  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4533c2c7918104788a2e572270cfdc68, type: 3}
  m_Name: Customer_witch
  m_EditorClassIdentifier: Assembly-CSharp::SproutOfDebt.Shop.CustomerData
  displayName: Old Witch
  neutral: {fileID: 21300000, guid: 9c43cd543e694c9da224453b04fa7320, type: 3}
  happy: {fileID: 21300000, guid: 489e8bd91b954cb68e00a5eabace6732, type: 3}
  disappointed: {fileID: 21300000, guid: ef2a61f1347042a7856ef78866250862, type: 3}
  stories:
  - potion: {fileID: 11400000, guid: 387b60560a6875448b61d4d63aba9d69, type: 2}
    lines:
    - My grandchildren visit this week. All seven of them. At once. I'll need something to keep my nerves in one piece, dearie.
  - potion: {fileID: 11400000, guid: 32930a2f26bc159479195a92f90f6ac0, type: 2}
    lines:
    - My old eyes can't read recipe books after sunset anymore. And the best brewing happens at night, as you well know.
  - potion: {fileID: 11400000, guid: 70b391c0507088648b7784764b44dc43, type: 2}
    lines:
    - The village children keep sneaking into my garden to see if I'm a real witch. I'd like to give them a kind little scare.
  - potion: {fileID: 11400000, guid: f56d0e854410b4143b7def29147754b8, type: 2}
    lines:
    - My cauldron fire went out for the first time in sixty years. It's a family heirloom, dearie, it mustn't go cold.
  - potion: {fileID: 11400000, guid: d6bd3f10682f8124eb003c8440e95252, type: 2}
    lines:
    - My back creaks louder than my broomstick these days. One sip of mandrake and I'll be flying again.
  requestLines:
  - So, be a dear and fetch me...
  - Now then, I'll be needing...
  thanksLines:
  - Bless your horns, little one.
  disappointedLines:
  - Never mind, dearie. Next time.
